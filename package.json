{
  "name": "@local/dsh-better-plan",
  "version": "0.1.10",
  "private": true,
  "description": "Antigravity-inspired plan previews for DSH with Better Sidebar, including Mermaid, math, syntax highlighting, safe workspace links, and tiered plan-mode structure guidance.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "dsh": "0.2.2-rc.5"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./client/mermaid": "./lib/client.mermaid.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/index.js",
    "lib/client.js",
    "lib/client.mermaid.js",
    "lib/THIRD-PARTY-NOTICES.txt",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.5 <4"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plan",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-resources",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test"
  },
  "overrides": {
    "katex": "$katex"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "esbuild": "0.25.12",
    "katex": "0.18.2",
    "lowlight": "^3.3.0",
    "mermaid": "^11.16.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-markdown": "10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "^6.0.0"
  }
}
